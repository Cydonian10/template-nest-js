PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nestjs_cqrs

# Genera un secreto aleatorio de al menos 32 caracteres; no uses este ejemplo en producción
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN_SECONDS=3600

# Reemplaza estos valores antes de ejecutar npm run migration:super-admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_NICK_NAME=Admin
SUPER_ADMIN_PASSWORD=cambiar-antes-de-usar-123
SUPER_ADMIN_FIRST_NAME=Nombre
SUPER_ADMIN_LAST_NAME=Apellido
SUPER_ADMIN_IDENTITY_DOCUMENT=1234567890
SUPER_ADMIN_DATE_OF_BIRTH=1990-01-31
